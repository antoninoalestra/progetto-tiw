{{!-- views/groups/list.hbs --}}
{{!-- Dashboard principale — riproduce il design originale di dashboard.html --}}

<div class="app-layout">

  {{!-- BARRA LATERALE DESKTOP --}}
  <aside class="sidebar-layout" id="app-sidebar">
    <div class="sidebar-header">
      <div class="sidebar-brand">Qotly</div>
    </div>

    <nav class="sidebar-nav" id="main-nav">
      <a href="#" class="nav-link active" data-target="tab-home">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2-2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        Dashboard
      </a>
      <a href="#" class="nav-link" data-target="tab-groups">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        I miei gruppi
      </a>
      <a href="#" class="nav-link" id="nav-btn-nuovo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
        Nuovo Gruppo
      </a>
      <a href="#" class="nav-link" data-target="tab-profile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Profilo
      </a>
    </nav>

    <div class="sidebar-footer">
      <form action="/logout" method="POST">
        <button type="submit" class="nav-link logout-action" style="width: 100%; border: none; background: none; cursor: pointer; text-align: left; color: rgba(255,255,255,0.7);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Esci
        </button>
      </form>
    </div>
  </aside>

  {{!-- CONTENUTO PRINCIPALE --}}
  <div class="main-wrapper">

    <header class="topbar">
      <div class="topbar-left">
        <div style="font-size: 20px; font-weight: 700; color: var(--color-brand-600);" class="mobile-only">Qotly</div>
      </div>
      <div class="topbar-right"></div>
    </header>

    <main class="page-content">

      {{!-- TAB: DASHBOARD --}}
      <section id="tab-home" class="tab-content active animate-in">
        {{!-- Scheda del Bilancio Principale --}}
        <div class="hero-balance-card">
          <div class="hero-label">Bilancio Totale</div>
          <div class="hero-amount tabular-nums">{{formatEuro netBalance}}</div>
          <div class="hero-chips">
            <div class="hero-chip positive">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
              Devi ricevere: <span>{{formatEuro totalCredit}}</span>
            </div>
            <div class="hero-chip negative">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
              Devi dare: <span>{{formatEuro totalOwed}}</span>
            </div>
          </div>
        </div>

        {{!-- Griglia delle Statistiche --}}
        <div class="stats-grid">
          <div class="card stat-card">
            <span class="stat-label">Spese Totali</span>
            <span class="stat-value tabular-nums">{{formatEuro totalExpenses}}</span>
          </div>
          <div class="card stat-card">
            <span class="stat-label">Gruppi Attivi</span>
            <span class="stat-value tabular-nums">{{groupCount}}</span>
          </div>
          <div class="card stat-card">
            <span class="stat-label">Da rimborsare</span>
            <span class="stat-value tabular-nums">{{formatEuro totalOwed}}</span>
          </div>
        </div>

        {{!-- Elementi della Dashboard --}}
        <div class="dashboard-widgets">
          {{!-- Attività Recente --}}
          <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
              <h3 style="margin: 0; font-size: 16px;">Attività Recente</h3>
            </div>
            <div class="feed-list">
              {{#if recentExpenses.length}}
                {{#each recentExpenses}}
                  <div class="feed-item">
                    <div class="feed-item-left">
                      <div class="feed-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                      </div>
                      <div class="feed-details">
                        <h4>{{this.description}}</h4>
                        <p>{{this.group_name}} • {{this.payer_name}}</p>
                      </div>
                    </div>
                    <div class="feed-amount">{{formatEuro this.amount}}</div>
                  </div>
                {{/each}}
              {{else}}
                <div class="empty-state" style="padding: 24px;"><p>Nessuna spesa recente.</p></div>
              {{/if}}
            </div>
          </div>

          {{!-- Salda i Conti (dettagli saldi per gruppo) --}}
          <div class="card">
            <div class="card-header">
              <h3 style="margin: 0; font-size: 16px;">Settle Up</h3>
            </div>
            <div class="card-body" style="padding: 0;">
              <div class="feed-list" style="max-height: 400px; overflow-y: auto;">
                {{#if balanceDetails.length}}
                  {{#each balanceDetails}}
                    <div class="feed-item">
                      <div class="feed-item-left">
                        <div class="feed-icon" style="background: var(--color-brand-100); color: var(--color-brand-600); font-weight: 600;">{{initial this.groupName}}</div>
                        <div class="feed-details">
                          <h4>{{this.groupName}}</h4>
                          <p>Il tuo bilancio</p>
                        </div>
                      </div>
                      <div style="text-align: right;">
                        {{#if (gt this.saldo 0)}}
                          <span class="badge badge-success">Avere {{formatEuro this.saldo}}</span>
                        {{else if (eq this.saldo 0)}}
                          <span class="badge badge-info">In pari</span>
                        {{else}}
                          <span class="badge badge-danger">Dare {{formatEuro (subtract 0 this.saldo)}}</span>
                        {{/if}}
                      </div>
                    </div>
                  {{/each}}
                {{else}}
                  <div class="empty-state" style="padding: 24px;"><p>Sei in pari in tutti i gruppi!</p></div>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- TAB: GRUPPI --}}
      <section id="tab-groups" class="tab-content" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h1 style="margin: 0;">I Miei Gruppi</h1>
          <button id="alt-nuovo-gruppo-btn" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span class="desktop-only">Crea Gruppo</span>
          </button>
        </div>

        {{#if groups.length}}
          <div class="groups-grid">
            {{#each groups}}
              <a href="/groups/{{this.id}}" style="text-decoration: none; color: inherit;">
                <div class="card card-hover" style="height: 100%;">
                  <div class="group-card-header" style="background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));">
                    <div class="avatar" style="background: rgba(255,255,255,0.2); width: 40px; height: 40px;">{{initial this.name}}</div>
                    {{#if (eq this.created_by ../currentUser.id)}}
                      <span class="badge" style="background: rgba(0,0,0,0.3); color: white;">Admin</span>
                    {{/if}}
                  </div>
                  <div class="group-card-body">
                    <div class="group-name-row"><h3>{{this.name}}</h3></div>
                    <div class="group-meta">
                      <span>{{this.member_count}} Membr{{#if (eq this.member_count 1)}}o{{else}}i{{/if}}</span>
                      <div class="avatar-stack">
                        {{#each this.members}}
                          <span class="avatar avatar-sm" style="background: var(--color-brand-400);">{{initial this.name}}</span>
                        {{/each}}
                        {{#if (gt ../this.member_count 4)}}
                          <span class="avatar avatar-sm" style="background: var(--color-neutral-500);">+{{subtract ../this.member_count 4}}</span>
                        {{/if}}
                      </div>
                    </div>
                    <div class="group-footer">
                      <span class="btn btn-secondary" style="width: 100%;">Apri Gruppo</span>
                    </div>
                  </div>
                </div>
              </a>
            {{/each}}
          </div>
        {{else}}
          <div class="empty-state" style="grid-column: 1 / -1; padding: 60px 24px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            <p>Nessun gruppo trovato. Creane uno per iniziare!</p>
          </div>
        {{/if}}
      </section>

      {{!-- TAB: PROFILO (SEMPLIFICATO) --}}
      <section id="tab-profile" class="tab-content" style="display: none; animation: slideDown 0.4s ease-out;">
        <h1 style="margin-bottom: 8px; font-size: 28px; color: #0f172a;">Impostazioni Profilo</h1>
        <p style="color: #64748b; margin-bottom: 40px; font-size: 15px;">Gestisci le tue informazioni personali e la sicurezza dell'account.</p>
        
        <div style="display: flex; align-items: center; gap: 24px; margin-bottom: 48px;">
          <div class="avatar avatar-lg" style="background: linear-gradient(135deg, var(--color-brand-400), var(--color-brand-600)); width: 80px; height: 80px; font-size: 32px; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);">
            {{initial currentUser.name}}
          </div>
          <div>
            <h2 style="margin: 0 0 4px 0; font-size: 24px; color: #0f172a;">{{currentUser.name}}</h2>
            <p style="margin: 0; color: #64748b; font-size: 15px;">{{currentUser.email}}</p>
          </div>
        </div>

        <form action="/profile" method="POST" style="max-width: 900px; margin: 0 auto;">
          <div style="display: grid; gap: 32px;">
            
            {{!-- Sezione Info Personali --}}
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f1f5f9; transition: box-shadow 0.3s ease;" onmouseover="this.style.boxShadow='0 8px 30px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.03)'">
              <h3 style="font-size: 18px; margin-bottom: 24px; color: #0f172a; display: flex; align-items: center; gap: 10px;">
                <div style="padding: 8px; background: #eff6ff; color: #3b82f6; border-radius: 8px;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                Informazioni Personali
              </h3>
              
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
                <div class="input-group" style="margin-bottom: 0;">
                  <label for="profile-name" style="font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Nome Completo</label>
                  <input type="text" id="profile-name" name="name" class="input" required value="{{currentUser.name}}" style="width: 100%; padding: 14px 16px; font-size: 16px; border: 2px solid #e2e8f0; border-radius: 10px; background: #f8fafc; transition: all 0.2s ease;" onfocus="this.style.background='white'; this.style.borderColor='#4f46e5'; this.style.boxShadow='0 0 0 4px rgba(79, 70, 229, 0.1)'" onblur="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'">
                </div>
                
                <div class="input-group" style="margin-bottom: 0;">
                  <label for="profile-email" style="font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Indirizzo Email</label>
                  <input type="email" id="profile-email" name="email" class="input" required value="{{currentUser.email}}" style="width: 100%; padding: 14px 16px; font-size: 16px; border: 2px solid #e2e8f0; border-radius: 10px; background: #f8fafc; transition: all 0.2s ease;" onfocus="this.style.background='white'; this.style.borderColor='#4f46e5'; this.style.boxShadow='0 0 0 4px rgba(79, 70, 229, 0.1)'" onblur="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'">
                </div>
              </div>
            </div>

            {{!-- Sezione Sicurezza --}}
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f1f5f9; transition: box-shadow 0.3s ease;" onmouseover="this.style.boxShadow='0 8px 30px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.03)'">
              <h3 style="font-size: 18px; margin-bottom: 24px; color: #0f172a; display: flex; align-items: center; gap: 10px;">
                <div style="padding: 8px; background: #fef2f2; color: #ef4444; border-radius: 8px;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                Sicurezza
              </h3>
              
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
                <div class="input-group" style="margin-bottom: 0;">
                  <label for="profile-password" style="font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Nuova Password <span style="font-weight: 400; color: #94a3b8; text-transform: none;">(lascia vuoto)</span></label>
                  <input type="password" id="profile-password" name="password" class="input" placeholder="Minimo 6 caratteri" style="width: 100%; padding: 14px 16px; font-size: 16px; border: 2px solid #e2e8f0; border-radius: 10px; background: #f8fafc; transition: all 0.2s ease;" onfocus="this.style.background='white'; this.style.borderColor='#4f46e5'; this.style.boxShadow='0 0 0 4px rgba(79, 70, 229, 0.1)'" onblur="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'">
                </div>
              </div>
            </div>

            {{!-- Pulsante --}}
            <div style="display: flex; justify-content: flex-end; padding-top: 8px;">
              <button type="submit" class="btn btn-primary" style="padding: 16px 48px; font-weight: 700; font-size: 16px; border-radius: 12px; background: linear-gradient(135deg, #4f46e5, #4338ca); box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4); border: none; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 10px;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 15px 30px rgba(79, 70, 229, 0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 25px rgba(79, 70, 229, 0.4)';">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Salva Modifiche
              </button>
            </div>
            
          </div>
        </form>
      </section>

    </main>
  </div>
</div>

{{!-- BARRA DI NAVIGAZIONE INFERIORE (Mobile) --}}
<nav class="bottom-nav mobile-only">
  <div class="bottom-nav-inner">
    <a href="#" class="bnav-link active" data-target="tab-home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2-2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      <span>Home</span>
    </a>
    <a href="#" class="bnav-link" data-target="tab-groups">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      <span>Gruppi</span>
    </a>
    <a href="#" class="bnav-link" id="mobile-nuovo-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
      <span>Nuovo</span>
    </a>
    <a href="#" class="bnav-link" data-target="tab-profile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      <span>Profilo</span>
    </a>
  </div>
</nav>

{{!-- FINESTRA MODALE: NUOVO GRUPPO (Crea + Unisciti unificati) --}}
<div id="new-group-modal" class="modal-overlay">
  <div class="modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <h2 style="margin: 0; font-size: 20px;">Gestione Gruppi</h2>
      <button id="close-new-group-modal" class="btn-ghost" style="padding: 8px; border-radius: 50%;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="tabs">
      <div class="tab-item tab-active" onclick="showGroupTab('create')">Crea Nuovo</div>
      <div class="tab-item" onclick="showGroupTab('join')">Unisciti</div>
    </div>

    {{!-- Scheda: Crea --}}
    <div id="group-tab-create" style="display: block; padding-top: 8px;">
      <p style="color: var(--text-muted); margin-bottom: 24px;">Crea un nuovo gruppo e invita i tuoi amici per dividere le spese.</p>
      <form id="create-group-form">
        <div class="input-group">
          <label for="group-name">Nome del Gruppo</label>
          <input type="text" id="group-name" class="input" required placeholder="Es. Viaggio a Parigi">
        </div>
        <div class="input-group">
          <label for="group-description">Descrizione (opzionale)</label>
          <input type="text" id="group-description" class="input" placeholder="Es. Spese weekend">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Crea Gruppo</button>
      </form>
    </div>

    {{!-- Scheda: Unisciti --}}
    <div id="group-tab-join" style="display: none; padding-top: 8px;">
      <p style="color: var(--text-muted); margin-bottom: 24px;">Hai un codice di invito? Inseriscilo qui sotto per entrare nel gruppo.</p>
      <form id="join-group-form">
        <div class="input-group">
          <label for="invite-code">Codice Invito</label>
          <input type="text" id="invite-code" class="input" required placeholder="Es. ABC123" maxlength="6" style="text-transform: uppercase; font-family: var(--font-mono); font-size: 20px; letter-spacing: 4px; text-align: center;">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Entra nel Gruppo</button>
      </form>
    </div>
  </div>
</div>
