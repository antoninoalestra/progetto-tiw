{{!-- views/groups/form.hbs --}}
{{!-- Form per creare un nuovo gruppo o unirsi a uno esistente --}}

{{> header}}

<div class="app-layout">
  <aside class="sidebar-layout" id="app-sidebar">
    <div class="sidebar-header">
      <a href="/groups" class="sidebar-brand">Qotly</a>
    </div>
    <nav class="sidebar-nav">
      <a href="/groups" class="nav-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        I miei gruppi
      </a>
    </nav>
    <div class="sidebar-footer">
      <form action="/logout" method="POST">
        <button type="submit" class="nav-link logout-action" style="width: 100%; border: none; background: none; cursor: pointer; text-align: left;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Esci
        </button>
      </form>
    </div>
  </aside>

  <div class="main-wrapper">
    <header class="topbar">
      <div class="topbar-left">
        <a href="/groups" class="btn-ghost" style="padding: 8px; border-radius: 50%;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <div style="font-size: 20px; font-weight: 700; color: var(--color-brand-600);" class="mobile-only">Qotly</div>
      </div>
    </header>

    <main class="page-content">
      <div style="max-width: 520px; margin: 0 auto;">

        {{#if (eq action "new")}}
          {{!-- FORM: CREA NUOVO GRUPPO --}}
          <h1 style="margin-bottom: 8px;">Crea un Nuovo Gruppo</h1>
          <p style="color: var(--text-muted); margin-bottom: 32px;">Crea un gruppo e invita i tuoi amici con il codice invito.</p>

          <div class="card">
            <div class="card-body">
              <form action="/groups" method="POST">
                <div class="input-group">
                  <label for="name">Nome del Gruppo</label>
                  <input type="text" id="name" name="name" class="input" required placeholder="Es. Viaggio a Parigi">
                </div>
                <div class="input-group">
                  <label for="description">Descrizione (opzionale)</label>
                  <input type="text" id="description" name="description" class="input" placeholder="Es. Spese per il weekend">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; height: 48px; font-size: 16px;">Crea Gruppo</button>
              </form>
            </div>
          </div>
        {{else}}
          {{!-- FORM: UNISCITI A UN GRUPPO --}}
          <h1 style="margin-bottom: 8px;">Unisciti a un Gruppo</h1>
          <p style="color: var(--text-muted); margin-bottom: 32px;">Hai un codice di invito? Inseriscilo qui sotto per entrare nel gruppo.</p>

          <div class="card">
            <div class="card-body">
              <form action="/groups/join" method="POST">
                <div class="input-group">
                  <label for="inviteCode">Codice Invito</label>
                  <input type="text" id="inviteCode" name="inviteCode" class="input" required placeholder="Es. abc12345" style="font-family: var(--font-mono); font-size: 20px; letter-spacing: 2px; text-align: center;">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; height: 48px; font-size: 16px;">Entra nel Gruppo</button>
              </form>
            </div>
          </div>
        {{/if}}

        <div style="text-align: center; margin-top: 24px;">
          <a href="/groups" class="btn btn-ghost">← Torna ai gruppi</a>
        </div>
      </div>
    </main>
  </div>
</div>
