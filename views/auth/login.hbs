{{!-- views/auth/login.hbs --}}
{{!-- Pagina di login con layout split: brand a sinistra, form a destra --}}

<div class="auth-layout">

  {{!-- Lato sinistro: Brand --}}
  <div class="auth-brand-side animate-in">
    <div class="brand-logo">
      Qotly
    </div>
    <div class="brand-content">
      <h1>Dividi le spese.<br>Non le amicizie.</h1>
      <div class="brand-features">
        <div class="feature-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Tieni traccia delle spese condivise
        </div>
        <div class="feature-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          Crea gruppi infiniti
        </div>
        <div class="feature-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          Bilanci calcolati istantaneamente
        </div>
      </div>
    </div>
    <div style="opacity: 0.8; font-size: 14px;">© 2026 Qotly. All rights reserved.</div>
  </div>

  {{!-- Lato destro: Modulo --}}
  <div class="auth-form-side animate-in" style="animation-delay: 100ms;">
    <div class="form-wrapper">

      <div class="mobile-brand">
        <h1 style="margin-top: 8px;">Qotly</h1>
      </div>

      <h2>Bentornato</h2>
      <p>Inserisci le tue credenziali per accedere.</p>

      <form id="loginForm" action="/login" method="POST">
        <div class="floating-label-group">
          <input type="email" id="email" name="email" class="input" required placeholder=" ">
          <label for="email">Indirizzo Email</label>
        </div>

        <div class="floating-label-group" style="position: relative;">
          <input type="password" id="password" name="password" class="input" required placeholder=" ">
          <label for="password">Password</label>
          <button type="button" class="password-toggle" onclick="togglePassword('password')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </button>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; height: 48px; font-size: 16px;">Accedi</button>
      </form>

      <div class="auth-links">
        Non hai ancora un account? <a href="/register">Registrati ora</a>
      </div>
    </div>
  </div>

</div>

<script>
  function togglePassword(inputId) {
    const input = document.getElementById(inputId);
    if (input.type === 'password') {
      input.type = 'text';
    } else {
      input.type = 'password';
    }
  }
</script>
